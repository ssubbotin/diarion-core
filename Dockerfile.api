# syntax=docker/dockerfile:1.7

FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/diarion-api ./cmd/diarion-api

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/diarion-api /app/diarion-api
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/app/diarion-api"]
