# syntax=docker/dockerfile:1.7

FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w -X main.version=docker' -o /out/diarion-mcp ./cmd/diarion-mcp

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/diarion-mcp /app/diarion-mcp
USER nonroot:nonroot
ENTRYPOINT ["/app/diarion-mcp"]
