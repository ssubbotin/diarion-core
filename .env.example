# Diarion local dev configuration.
# Copy to .env (which is gitignored) and edit. Do not commit .env.

# API
API_LISTEN=:8080
BASE_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://diarion:diarion@localhost:5432/diarion?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Google OAuth (placeholder; obtain real credentials before M2)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 32 random bytes hex-encoded. Generate: openssl rand -hex 32
SESSION_SECRET=

# 32 random bytes hex-encoded. Generate: openssl rand -hex 32
DIARION_MASTER_KEY=
